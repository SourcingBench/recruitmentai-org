---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import vendors from '../../data/vendors.json';
import { SITE_NAME, SITE_URL, YEAR, LAST_REVIEWED, fmtDate, crumbs } from '../../data/site';
const types = [...new Map(vendors.map((v) => [v.typeSlug, v.type])).entries()];
const schema = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: 'Recruitment AI vendor landscape', itemListElement: vendors.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: v.name, url: `${SITE_URL}/vendors/${v.slug}/` })) }, crumbs([{ name: 'Home', path: '/' }, { name: 'Vendor landscape', path: '/vendors/' }])];
---
<Base title={`Recruitment AI Vendor Landscape (${YEAR}): Who Does What | ${SITE_NAME}`} description="The recruitment AI market mapped by type: sourcing agents, AI talent search, screening and matching, conversational AI, interview intelligence, scheduling and ATS-native AI, with what each vendor automates and what to ask them." path="/vendors/" schema={schema}>
  <div class="wrap doc"><Toc current="vendors" />
    <article class="prose">
      <p class="crumbs"><a href="/">Home</a> › Vendor landscape</p>
      <h1>The recruitment AI vendor landscape</h1>
      <p class="byline">Reviewed {fmtDate(LAST_REVIEWED)} · descriptive, not a ranking · no vendor pays for inclusion</p>
      <p>Vendors grouped by the type of work their AI does and how autonomous it is. “Agent” means the software completes the task and reports back; “Assistant” means it helps a person who still does the task.</p>
      <div class="tablewrap"><table><thead><tr><th>Vendor</th><th>Type</th><th>Autonomy</th><th>Candidate channel</th><th>Pricing</th></tr></thead><tbody>{vendors.map((v) => <tr><td><a href={`/vendors/${v.slug}/`}>{v.name}</a></td><td>{v.type}</td><td>{v.autonomy}</td><td>{v.channels}</td><td>{v.pricing}</td></tr>)}</tbody></table></div>
      {types.map(([slug, name]) => <section id={slug}><h2>{name}</h2><div class="grid">{vendors.filter((v) => v.typeSlug === slug).map((v) => <a class="tile" href={`/vendors/${v.slug}/`}><span class={`pill ${v.autonomy.startsWith('Agent') ? 'mint' : ''}`}>{v.autonomy}</span><h3>{v.name}</h3><p>{v.summary}</p></a>)}</div></section>)}
      <div class="callout warn"><b>Not listed:</b> tools whose main claim is LinkedIn automation. Sending automated messages through a LinkedIn account breaches LinkedIn's terms and risks the account; the sourcing agents profiled here contact candidates by email and SMS.</div>
    </article>
  </div>
</Base>
